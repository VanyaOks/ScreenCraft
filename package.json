{
  "name": "dsh-screenshot-annotator",
  "version": "0.2.2",
  "type": "module",
  "description": "Annotate screenshots with numbered colored markers, rectangles, arrows, and comments before sending them to the agent in DSH.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanyaOks/Screenshot.git"
  },
  "homepage": "https://github.com/VanyaOks/Screenshot#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
